{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Active Connections",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "net_scanner_traffic_active_connections",
          "legendFormat": "Active"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          }
        }
      }
    },
    {
      "title": "Unique Destinations",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "net_scanner_traffic_unique_destinations",
          "legendFormat": "Destinations"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      }
    },
    {
      "title": "Unique Countries",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "net_scanner_geo_unique_countries",
          "legendFormat": "Countries"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "purple", "value": null }
            ]
          }
        }
      }
    },
    {
      "title": "Total Flows",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(net_scanner_traffic_flows_total)",
          "legendFormat": "Total Flows"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "orange", "value": null }
            ]
          }
        }
      }
    },
    {
      "title": "Anomalies Detected",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(net_scanner_anomaly_events_total)",
          "legendFormat": "Anomalies"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "title": "Total Bytes Captured",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(net_scanner_traffic_bytes_total)",
          "legendFormat": "Bytes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      }
    },
    {
      "title": "Bandwidth Over Time (by Protocol)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (protocol) (rate(net_scanner_traffic_bytes_total[1m]))",
          "legendFormat": "{{protocol}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "pointSize": 5,
            "lineInterpolation": "smooth"
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "title": "Connection Rate Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(net_scanner_traffic_flows_total[1m]))",
          "legendFormat": "flows/sec"
        },
        {
          "expr": "sum by (protocol) (rate(net_scanner_traffic_flows_total[1m]))",
          "legendFormat": "{{protocol}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth"
          }
        }
      }
    },
    {
      "title": "Protocol Breakdown",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (protocol) (net_scanner_traffic_bytes_total)",
          "legendFormat": "{{protocol}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["value", "percent"]
        }
      }
    },
    {
      "title": "Top 10 Destination IPs",
      "type": "table",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "targets": [
        {
          "rawSql": "SELECT dst_ip::text AS \"Destination IP\", COALESCE(dst_hostname, '-') AS \"Hostname\", COALESCE(process_name, '-') AS \"Process\", protocol AS \"Protocol\", COUNT(*) AS \"Connections\", SUM(bytes_sent + bytes_recv) AS \"Total Bytes\" FROM traffic_flows WHERE captured_at > now() - INTERVAL '1 hour' GROUP BY dst_ip, dst_hostname, process_name, protocol ORDER BY \"Total Bytes\" DESC LIMIT 10",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Total Bytes" },
            "properties": [
              { "id": "unit", "value": "bytes" }
            ]
          }
        ]
      }
    },
    {
      "title": "Top 10 Countries by Traffic",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "targets": [
        {
          "rawSql": "SELECT COALESCE(country_name, 'Unknown') AS \"Country\", SUM(bytes_sent + bytes_recv) AS \"Total Bytes\" FROM traffic_flows WHERE captured_at > now() - INTERVAL '1 hour' GROUP BY country_name ORDER BY \"Total Bytes\" DESC LIMIT 10",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "title": "Traffic by Continent",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 20 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "targets": [
        {
          "rawSql": "SELECT COALESCE(continent, 'Unknown') AS \"Continent\", SUM(bytes_sent + bytes_recv) AS \"Total Bytes\" FROM traffic_flows WHERE captured_at > now() - INTERVAL '1 hour' GROUP BY continent ORDER BY \"Total Bytes\" DESC",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["value", "percent"]
        }
      }
    },
    {
      "title": "Port Breakdown",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 20 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "targets": [
        {
          "rawSql": "SELECT dst_port::text AS \"Port\", protocol AS \"Protocol\", COUNT(*) AS \"Connections\", SUM(bytes_sent + bytes_recv) AS \"Total Bytes\" FROM traffic_flows WHERE captured_at > now() - INTERVAL '1 hour' AND dst_port > 0 GROUP BY dst_port, protocol ORDER BY \"Total Bytes\" DESC LIMIT 15",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "title": "Anomaly Events",
      "type": "table",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 20 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "targets": [
        {
          "rawSql": "SELECT detected_at AS \"Time\", event_type AS \"Type\", severity AS \"Severity\", description AS \"Description\" FROM anomaly_events WHERE detected_at > now() - INTERVAL '24 hours' ORDER BY detected_at DESC LIMIT 20",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Severity" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "info": { "text": "INFO", "color": "blue" } } },
                  { "type": "value", "options": { "warning": { "text": "WARNING", "color": "yellow" } } },
                  { "type": "value", "options": { "critical": { "text": "CRITICAL", "color": "red" } } }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "title": "Traffic World Map (by Country)",
      "type": "geomap",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "targets": [
        {
          "rawSql": "SELECT country_name AS \"Country\", latitude AS \"Latitude\", longitude AS \"Longitude\", SUM(bytes_sent + bytes_recv) AS \"Total Bytes\", COUNT(DISTINCT dst_ip) AS \"Unique IPs\" FROM traffic_flows WHERE captured_at > now() - INTERVAL '1 hour' AND latitude IS NOT NULL AND longitude IS NOT NULL GROUP BY country_name, latitude, longitude ORDER BY \"Total Bytes\" DESC",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "view": {
          "id": "coords",
          "lat": 20,
          "lon": 0,
          "zoom": 2
        },
        "controls": {
          "showZoom": true,
          "showAttribution": true,
          "mouseWheelZoom": true,
          "showScale": false,
          "showMeasure": false,
          "showDebug": false
        },
        "tooltip": { "mode": "details" },
        "basemap": {
          "type": "default",
          "name": "Basemap"
        },
        "layers": [
          {
            "type": "markers",
            "name": "Traffic by Country",
            "location": {
              "mode": "coords",
              "latitude": "Latitude",
              "longitude": "Longitude"
            },
            "config": {
              "showLegend": true,
              "style": {
                "size": {
                  "field": "Unique IPs",
                  "fixed": 8,
                  "max": 30,
                  "min": 6
                },
                "color": {
                  "fixed": "dark-orange"
                },
                "opacity": 0.6,
                "symbol": {
                  "fixed": "img/icons/marker/circle.svg",
                  "mode": "fixed"
                },
                "symbolAlign": { "horizontal": "center", "vertical": "center" },
                "textConfig": {
                  "fontSize": 12,
                  "offsetX": 0,
                  "offsetY": 0,
                  "textAlign": "center",
                  "textBaseline": "middle"
                }
              }
            },
            "tooltip": true
          }
        ]
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["network", "traffic", "scanner"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "PostgreSQL",
        "multi": false,
        "name": "DS_POSTGRES",
        "options": [],
        "query": "postgres",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Network Traffic Analytics",
  "uid": "net-scanner-traffic",
  "version": 1
}
